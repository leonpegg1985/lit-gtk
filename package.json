{
  "name": "@lit-gtk/bundle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@lit-gtk-examples/gtk-demo",
    "dev:hello": "npm run dev --workspace=@lit-gtk-examples/hello-world",
    "dev:kitchen": "npm run dev --workspace=@lit-gtk-examples/kitchen-sink",
    "build": "npm run build --workspaces",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "tsc --noEmit",
    "docs": "npm run docs --workspace=@lit-gtk/library"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lit": "^3.3.3",
    "motion": "^12.23.24",
    "ts-jest": "^29.4.9",
    "typedoc": "^0.28.19",
    "vite": "^6.2.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
